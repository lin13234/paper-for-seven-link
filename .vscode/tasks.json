{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: Build paper",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\latex_build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LaTeX: Watch paper",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\latex_build.ps1",
        "-Watch"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "LaTeX: Clean auxiliary files",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\latex_clean.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
